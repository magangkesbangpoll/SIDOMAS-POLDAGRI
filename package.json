{
  "name": "sidomas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistem Digitalisasi Data Ormas (SIDOMAS)",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "setup": "npm install && cd client && npm install",
    "admins": "node server/tools.js admins",
    "reset-admin": "node server/tools.js reset-admin",
    "test-email": "node server/tools.js test-email",
    "check-reset": "node server/tools.js check-reset",
    "set-email": "node server/tools.js set-email",
    "backup-now": "node server/tools.js backup-now",
    "rapikan-drive": "node server/tools.js rapikan-drive",
    "organize-drive": "node server/tools.js rapikan-drive"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
