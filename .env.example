# Salin menjadi .env lalu sesuaikan.
# JANGAN menulis data asli di file ini (.env.example ikut terunggah ke GitHub). Nilai asli hanya di file .env.

PORT=3001
# Alamat tempat aplikasi diakses (dipakai pada tautan reset password). Lokal: http://localhost:5173
APP_URL=http://localhost:5173
DATA_DIR=./data
# Isi acak panjang. Jika kosong, dibuat otomatis di data/secret.key
SECRET=
# Ubah ke true jika memakai HTTPS
COOKIE_SECURE=false
# Isi 1 jika di belakang reverse proxy (Nginx, Fly.io, dsb.)
TRUST_PROXY=

# ===== Akun admin awal (hanya dipakai saat database pertama kali dibuat) =====
# Jika ADMIN_INITIAL_PASSWORD kosong, password acak dicetak SEKALI di log server. Wajib diganti saat login pertama.
ADMIN_INITIAL_PASSWORD=
ADMIN_EMAIL=

# ===== Penyimpanan Google Drive (PDF, logo, dan backup database harian) =====
# Cara membuat: lihat docs/google-apps-script.gs dan README.md. Uji dengan: node server/test-drive.js
GDRIVE_URL=
GDRIVE_SECRET=

# ===== EMAIL (wajib: OTP tracking + tautan "Lupa Password") =====
# Tanpa isian ini, email TIDAK terkirim dan ormas tidak bisa menerima Kode OTP tracking.
# Contoh Gmail: aktifkan 2-Step Verification, buat App password 16 karakter tanpa spasi, lalu isi di bawah.
# SMTP_USER harus sama dengan akun yang membuat App password; SMTP_FROM disarankan sama.
# Uji setelah mengisi: npm run test-email -- emailanda@gmail.com  (lalu restart server)
# Jika SMTP Gmail timeout, port 465/587 biasanya diblokir jaringan. Coba hotspot, atau relay port 443:
# SMTP_HOST=smtp-relay.brevo.com / SMTP_PORT=443 / SMTP_SECURE=true (user & pass dari akun Brevo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=GANTI_dengan_email_pengirim@gmail.com
SMTP_PASS=GANTI_dengan_sandi_aplikasi_16_karakter_tanpa_spasi
SMTP_FROM="SIDOMAS" <GANTI_dengan_email_pengirim@gmail.com>

# Pesan WhatsApp otomatis (konfirmasi pendaftaran ormas baru). Kosongkan WA_TOKEN untuk menonaktifkan.
# Pakai gateway WhatsApp (bawaan: Fonnte, nomor pengirim = nomor yang disambungkan di Fonnte).
WA_TOKEN=
# WA_API_URL=https://api.fonnte.com/send
